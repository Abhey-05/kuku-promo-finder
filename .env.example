# Copy this file to .env and fill in. .env is git-ignored. Never commit it.
# Used by the CLI only. On the website, paste the key into Settings instead.
# KUKU_LLM_MODEL: a light Flash-Lite model, confirmed with a real run on 2026-11-08. The bigger
# Flash models returned "high demand" (HTTP 503) that day. List others with:
#   npm run cli -- --provider gemini --list-models
KUKU_LLM_PROVIDER=gemini
KUKU_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
KUKU_LLM_BASE_URL=
KUKU_ALLOW_PACK_TO_LLM=0
