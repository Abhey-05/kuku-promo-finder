# Copy this file to .env and fill in. .env is git-ignored. Never commit it.
# Used by the CLI only. On the website, paste the key into Settings instead.
# KUKU_LLM_MODEL: newest free-tier Flash per public pricing pages (2026-11). Not yet confirmed
# against the API; confirm with: npm run cli -- --provider gemini --list-models
KUKU_LLM_PROVIDER=gemini
KUKU_LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
KUKU_LLM_BASE_URL=
KUKU_ALLOW_PACK_TO_LLM=0
